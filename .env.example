# =============================================================================
# Bring Me Food: environment for docker-compose.yml
#
#   cp .env.example .env     (never commit .env)
#
# Rules for this file: plain KEY=value lines, no quotes. ${VAR} references to
# variables defined EARLIER in this file are expanded by Compose.
# Where a value below says "copy from your current .env", the example is only
# a guess at the shape: use the value your services already work with.
# =============================================================================

# ---------------------------------------------------------------------------
# 0. Deployment switches
#
# COMPOSE_PROFILES decides what runs. Pick exactly ONE TLS strategy, then add
# any optional parts, comma-separated, no spaces.
#
#   TLS strategy (one of):
#     https-letsencrypt  public server; free certificates, issued automatically
#     https-custom       your certificate files in ./tls (cert.pem, key.pem):
#                        mkcert for local development, or one from your provider
#     http               plain HTTP, no certificates
#
#   Optional parts:
#     infra              local Postgres + Redis (Valkey) + OpenSearch.
#                        Leave it out to use Supabase, Redis Cloud, ...
#     observability      local Grafana + OTLP collector
#     backup             scheduled pg_dump of POSTGRES_HOST into ./backups
#
# Examples:
#   Production VM, everything local:    https-letsencrypt,infra,backup
#   Production VM, Supabase + cloud:    https-letsencrypt
#   Laptop, local infra, trusted HTTPS: https-custom,infra
#   Laptop, Supabase, no certificates:  http
#
# With https-* use https:// in every URL below; with http use http:// (and ws://).
# ---------------------------------------------------------------------------

COMPOSE_PROFILES=https-letsencrypt,infra

# ---------------------------------------------------------------------------
# 1. Installation (required)
# ---------------------------------------------------------------------------

# Base domain of this installation.
DOMAIN=example.com

# Hostnames (create DNS records for these, or one wildcard *.<DOMAIN>).
# They mirror the old nginx setup:
#   API_HOST   all backend APIs, WebSockets and MCP endpoints, routed by path
#              (was http://localhost:8001)
#   *_HOST     one host per web app (was <app>.localhost:8000)
# Keep API_HOST under the same registrable domain as the app hosts: the apps
# rely on same-site cookies, as they did with localhost in dev.
API_HOST=api.${DOMAIN}
AUTH_HOST=auth.${DOMAIN}
RESTAURANTS_HOST=restaurants.${DOMAIN}
ADMIN_HOST=admin.${DOMAIN}
CLIENT_HOST=client.${DOMAIN}
DELIVERY_HOST=delivery.${DOMAIN}

# Let's Encrypt account email. Required for https-letsencrypt, ignored otherwise.
ACME_EMAIL=ops@example.com

# Artifact Registry path that `make push` publishes to:
#   <REGION>-docker.pkg.dev/<PROJECT_ID>/<REPOSITORY>
REGISTRY=europe-west4-docker.pkg.dev/my-project/my-repository

# Image tags (the git SHA used by `make build push`). Pin them, do not use latest.
BACKEND_VERSION=a1b2c3d
FRONTEND_VERSION=a1b2c3d

# ---------------------------------------------------------------------------
# 2. Scaling (optional). Replicas per tier; override one service with
#    `docker compose up -d --scale <service>=N`.
# ---------------------------------------------------------------------------

HTTP_REPLICAS=1
WS_REPLICAS=1
GRPC_REPLICAS=1
CONSUMER_REPLICAS=1
WEB_REPLICAS=1

# ---------------------------------------------------------------------------
# 3. Traefik (optional)
# ---------------------------------------------------------------------------

#TRAEFIK_VERSION=v3.5
#TRAEFIK_LOG_LEVEL=INFO
#APP_NETWORK=bmf-network
# Use Let's Encrypt staging while testing (avoids rate limits, certs untrusted):
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ---------------------------------------------------------------------------
# 4. Database, Redis, search, telemetry
#    Use ONE of the two blocks for each service: local (profile `infra`) or
#    external. Avoid $ and # in passwords (Compose reads $ as a variable).
# ---------------------------------------------------------------------------

# PostgreSQL: writes go to POSTGRES_HOST, reads to POSTGRES_HOST_READ
# (the same host unless you run a replica).
#   local (infra):  POSTGRES_HOST=postgres  POSTGRES_HOST_READ=postgres  POSTGRES_DB_PORT=5432
#   Supabase:       use the pooler/direct host and port from the Supabase dashboard
POSTGRES_HOST=postgres
POSTGRES_HOST_READ=postgres
POSTGRES_DB_PORT=5432
POSTGRES_USER=bmf
POSTGRES_PWD=CHANGE_ME
POSTGRES_DB=bmf

# Optional connection tuning (e.g. for the Supabase pooler). Empty = not set.
# Copy the values from your working .env.
POSTGRES_SCHEMA_PREFIX=
POSTGRES_DB_QUERY_EXEC_MODE=
POSTGRES_DB_MAX_OPEN_CONNS=
POSTGRES_DB_MAX_IDLE_CONNS=
POSTGRES_DB_CONN_MAX_IDLE_SECONDS=
POSTGRES_DB_CONN_MAX_LIFETIME_SECONDS=

# Redis-compatible broker (message broker + cache)
#   local (infra):  REDIS_ADDR=redis:6379  REDIS_TLS=false
#   Redis Cloud:    host:port from the provider, REDIS_TLS as the provider requires
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_TLS=false

#   local (infra):  http://opensearch:9200
OPENSEARCH_URL=http://opensearch:9200

# OTLP gRPC endpoint of your collector, host:port. Leave empty to send nothing.
# With the `observability` profile: otel-lgtm:4317
OTEL_COLLECTOR_URL=

# Local infra tuning (all optional)
#POSTGRES_IMAGE=postgres:17-alpine
#POSTGRES_MAX_CONNECTIONS=300
#POSTGRES_LOCAL_PORT=5432
#REDIS_IMAGE=valkey/valkey:8-alpine
#OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.1
#OPENSEARCH_HEAP=512m
#LGTM_IMAGE=grafana/otel-lgtm:latest
#GRAFANA_PORT=3000
#BACKUP_INTERVAL_SECONDS=86400
#BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# 5. Backend: behaviour
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
LOGGER_NO_COLOR=true

# Rate limiter (per IP)
THROTTLING_BURST=50
THROTTLING_REFILL_RATE=10

# Browser origins allowed by CORS (copy the delimiter your services expect).
ALLOWED_ORIGINS=https://${AUTH_HOST} https://${RESTAURANTS_HOST} https://${ADMIN_HOST} https://${CLIENT_HOST} https://${DELIVERY_HOST}

# Redis consumer-group suffix. Bump it (e.g. _v2) to make consumers re-read
# streams from the start; keep it stable otherwise.
CONSUMERS_VERSION=

# gRPC ports (internal network only). These are the defaults.
AUTH_GRPC_SERVER_PORT=50050
CLIENT_GRPC_SERVER_PORT=50051
RESTAURANT_GRPC_SERVER_PORT=50052
SUBSCRIPTION_GRPC_SERVER_PORT=50053
BILLING_GRPC_SERVER_PORT=50054
NOTIFICATION_GRPC_SERVER_PORT=50055
RATING_GRPC_SERVER_PORT=50056

# ---------------------------------------------------------------------------
# 6. Backend: public URLs (copy from your current .env)
#    AUTH_URL must end with a slash: paths are appended to it.
# ---------------------------------------------------------------------------

AUTH_URL=https://${AUTH_HOST}/
ADMIN_AUTH_URL=https://${ADMIN_HOST}/admin/auth
ADMIN_WEB_APP_URL=https://${ADMIN_HOST}/
RESTAURANTS_AUTH_URL=https://${RESTAURANTS_HOST}/restaurants/auth
RESTAURANTS_WEB_APP_URL=https://${RESTAURANTS_HOST}/
CLIENT_AUTH_URL=https://${CLIENT_HOST}/client/auth
CLIENT_WEB_APP_URL=https://${CLIENT_HOST}/
DELIVERY_AUTH_URL=https://${DELIVERY_HOST}/delivery/auth
DELIVERY_WEB_APP_URL=https://${DELIVERY_HOST}/
REDIRECT_INFO_MAP=CHANGE_ME

# ---------------------------------------------------------------------------
# 7. Backend: secrets (generate per installation, never reuse across customers)
#    Key formats and lengths must match what the services expect, e.g.
#    `openssl rand -base64 32` or `openssl rand -hex 32`.
# ---------------------------------------------------------------------------

JWT_KEY=CHANGE_ME
JWE_KEY=CHANGE_ME
PERSONAL_INFORMATION_ENCRYPTION_KEY=CHANGE_ME
LOOKUP_TOKEN_ENCRYPTION_KEY=CHANGE_ME
MCP_TOKEN_KEY=CHANGE_ME
IMAGES_TOKEN_SIGNING_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# 8. Backend: third-party services
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_BILLING_WEBHOOK_SECRET=whsec_CHANGE_ME

# Email
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@example.com

# LiveKit
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_AGENT_NAME=CHANGE_ME

# Image storage. The credentials file must exist under ./credentials/ and the
# path below is the path INSIDE the container (./credentials is mounted at /credentials).
FIREBASE_CREDENTIALS_PATH=/credentials/firebase.json
FIREBASE_BUCKET=my-project.appspot.com
UNSPLASH_ACCESS_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# 9. Frontend (VITE_*). Passed to the web containers as environment variables.
#
#    Take the values from your dev .env and swap only the origins:
#      http://localhost:8001            ->  https://${API_HOST}
#      http://<app>.localhost:8000      ->  https://${<APP>_HOST}
#      ws://localhost:8001              ->  wss://${API_HOST}
#    Keep every path suffix (/api/v1/..., /ws/..., /restaurants/login, ...)
#    exactly as in dev. The values below show the origin only: append your
#    paths where your dev values have them.
# ---------------------------------------------------------------------------

VITE_OTEL_ENDPOINT=

# API origin (paths such as /api/v1/auth are routed by Traefik on API_HOST)
VITE_AUTH_ENDPOINT=https://${API_HOST}/api/v1
VITE_CLIENT_ENDPOINT=https://${API_HOST}/api/v1
VITE_RESTAURANTS_ENDPOINT=https://${API_HOST}/api/v1
VITE_DELIVERY_ENDPOINT=https://${API_HOST}/api/v1
VITE_ADMIN_ENDPOINT=https://${API_HOST}/api/v1
VITE_IMAGES_ENDPOINT=https://${API_HOST}/api/v1
VITE_SUBSCRIPTION_ENDPOINT=https://${API_HOST}/api/v1
VITE_BILLING_ENDPOINT=https://${API_HOST}/api/v1
VITE_RATING_ENDPOINT=https://${API_HOST}/api/v1

# WebSockets (/ws/client, /ws/restaurants, /ws/delivery)
VITE_CLIENT_WS_ENDPOINT=https://${API_HOST}
VITE_RESTAURANTS_WS_ENDPOINT=https://${API_HOST}
VITE_DELIVERY_WS_ENDPOINT=https://${API_HOST}

# Login / logout / refresh: same-origin paths on each app host. Traefik forwards
# /<app>/login, /logout, /refresh and /auth to the backend (as nginx_1.conf did).
VITE_CLIENT_LOGIN_URL=https://${CLIENT_HOST}/client/login
VITE_RESTAURANTS_LOGIN_URL=https://${RESTAURANTS_HOST}/restaurants/login
VITE_DELIVERY_LOGIN_URL=https://${DELIVERY_HOST}/delivery/login
VITE_ADMIN_LOGIN_URL=https://${ADMIN_HOST}/admin/login

VITE_CLIENT_LOGOUT_URL=https://${CLIENT_HOST}/client/logout
VITE_RESTAURANTS_LOGOUT_URL=https://${RESTAURANTS_HOST}/restaurants/logout
VITE_DELIVERY_LOGOUT_URL=https://${DELIVERY_HOST}/delivery/logout
VITE_ADMIN_LOGOUT_URL=https://${ADMIN_HOST}/admin/logout

VITE_CLIENT_REFRESH_URL=https://${CLIENT_HOST}/client/refresh
VITE_RESTAURANTS_REFRESH_URL=https://${RESTAURANTS_HOST}/restaurants/refresh
VITE_DELIVERY_REFRESH_URL=https://${DELIVERY_HOST}/delivery/refresh
VITE_ADMIN_REFRESH_URL=https://${ADMIN_HOST}/admin/refresh

# Third-party (browser-exposed keys: restrict them by domain)
VITE_GOOGLE_MAPS_API_KEY=CHANGE_ME
VITE_LIVEKIT_URL=wss://my-project.livekit.cloud